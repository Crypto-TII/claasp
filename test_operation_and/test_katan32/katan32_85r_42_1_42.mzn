constraint 2*dummy_upper_xor_0_1[0] = (upper_plaintext[0] + upper_plaintext[5] + upper_and_0_0[0] + upper_plaintext[9] + upper_key[79] + upper_xor_0_1[0]);
constraint table([upper_plaintext[19]]++[upper_plaintext[21]]++[upper_and_0_2[0]]++[upper_p[1]],upper_and2inputs_DDT);
constraint table([upper_plaintext[23]]++[upper_plaintext[28]]++[upper_and_0_3[0]]++[upper_p[2]],upper_and2inputs_DDT);
constraint 2*dummy_upper_xor_0_4[0] = (upper_plaintext[13] + upper_plaintext[24] + upper_and_0_2[0] + upper_and_0_3[0] + upper_key[78] + upper_xor_0_4[0]);
constraint upper_intermediate_output_0_5[0] = upper_plaintext[1];
